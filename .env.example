# fixture = no model calls; openrouter = Deep Agent with read-only MCP tools
AGENT_MODE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Paid models require explicit opt-in. Use an account-side credit limit as well.
ALLOW_PAID_MODELS=false
AGENT_TIMEOUT_SECONDS=90
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=routerescue
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional workspace ID for a key linked to multiple workspaces
LANGSMITH_WORKSPACE_ID=
DATABASE_PATH=data/routerescue.sqlite3
COOKIE_SECURE=false
